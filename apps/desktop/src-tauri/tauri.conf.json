{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NEXUS",
  "version": "0.1.0",
  "identifier": "com.nexus.adaptive.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {"label": "main", "title": "NEXUS — Observación local", "width": 1280, "height": 850, "minWidth": 960, "minHeight": 600}
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420; img-src 'self' data:; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {"active": false, "icon": ["icons/icon.png", "icons/icon.ico"]}
}
